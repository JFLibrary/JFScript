// (S3) the syntax pass: the conditional, defaults, named arguments, destructuring, the
// shorthand {a, b} and lists from a loop
fn area({w, h = 1}) { return w * h }
fn greet(name, greeting = "Hallo", end = "!") { return "${greeting} ${name}${end}" }

let [first, ...rest] = [3, 1, 2]
let {port = 80, host} = {host: "x"}
let pairs = [[1, "a"], [2, "b"]]
for [i, s] in pairs { print(i, s) }
let a = 1
let b = 2
[a, b] = [b, a]

print(area({w: 3}), area({w: 2, h: 5}))
print(greet("Anna"), greet("Ben", end: "?"), greet(greeting: "Hi", name: "Cem"))
print(first, rest, port, host, a, b)
print({a, b, port})
print([x * x for x in rest if x > 1], [k for k, v in {p: 1, q: nil} if v != nil])
print(len(pairs) > 1 ? "mehrere" : "eins", math.clamp(7, lo: 0, hi: 5))
try { greet(nme: "x") } catch e { print(e) }

// a list from a loop waits with its invocation
let waits = [await timer.sleep(10, i) for i in 0..3]
print(waits, now())
