# jfs/PACKAGE: the runner's identity and packages (JFLib's docs/PACKAGING.md)
#   cargo jflib package -p jfs
# version= is the app's own version (MAJOR.MINOR.PATCH, docs/VERSIONING.md); the program reads it
# as rt::app_version!(), the packages and lib/update use it.  The library has its own (Cargo.toml).
# A program without a window: cargo jflib package makes desktop packages for window apps; here
# version= (rt::app_version!()) and app_id= matter.
display=jfs
version=0.1.0
publisher=JFLib
summary=Führt .jfs-Skripte auf der Konsole aus
description=jfs führt Skripte der Sprache von JFNetworker (.jfs) auf der Kommandozeile aus: Ausgabe auf der Konsole, Timer mit echter oder virtueller Uhr, Grenzen für Rechenzeit und Speicher.
generic=Skript-Runner
categories=Development;ConsoleOnly;
deb_name=jfs
# Flatpak, AppStream and the MSIX identity: reverse DNS of a domain or project you control
app_id=org.jflib.jfs
homepage=https://github.com/JFLibrary/JFScript
# SPDX licence of the packages (default LicenseRef-proprietary)
license=MIT OR Apache-2.0
default_win=winui
default_linux=winui
styles=winui
